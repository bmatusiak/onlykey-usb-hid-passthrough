# The RP2040 ROM bootloader (BOOTSEL), as used by picotool.
#
# The rig passes THREE USB identities through, and this is the one nothing else
# installs a rule for:
#
#   1D50:60FC  OnlyKey application  -- covered by 49-onlykey.rules
#   16C0:0478  Teensy HalfKay       -- covered by 00-teensy.rules
#   2E8A:*     RP2040 BOOTSEL       -- this file
#
# Without it picotool FINDS the device and then fails to claim it, which reads
# like the board never reached BOOTSEL rather than like a permission problem.
#
# Install with:
#   sudo cp tools/60-rp2040-bootsel.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Replace MODE:="0666" with GROUP:="plugdev" if you would rather not grant
# access to every user on the machine.

SUBSYSTEMS=="usb", ATTRS{idVendor}=="2e8a", MODE:="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="2e8a", MODE:="0666"
